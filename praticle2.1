import java.io.*;
import java.util.*;

// Part b: Student class for serialization
class Student implements Serializable {
    private static final long serialVersionUID = 1L;
    int studentID;
    String name;
    double grade;

    Student(int studentID, String name, double grade) {
        this.studentID = studentID;
        this.name = name;
        this.grade = grade;
    }

    public String toString() {
        return "ID: " + studentID + ", Name: " + name + ", Grade: " + grade;
    }
}

// Part c: Employee class for file handling
class Employee implements Serializable {
    private static final long serialVersionUID = 1L;
    int id;
    String name;
    String designation;
    double salary;

    Employee(int id, String name, String designation, double salary) {
        this.id = id;
        this.name = name;
        this.designation = designation;
        this.salary = salary;
    }

    public String toString() {
        return "ID: " + id + ", Name: " + name + ", Designation: " + designation + ", Salary: " + salary;
    }
}

public class Main {
    public static void main(String[] args) throws IOException, ClassNotFoundException {
        Scanner sc = new Scanner(System.in);

        // ---------------- Part a: Sum of Integers ----------------
        System.out.println("Part a: Sum of Integers Using Autoboxing and Unboxing");
        ArrayList<Integer> numbers = new ArrayList<>();
        System.out.println("Enter integers separated by space:");
        String[] input = sc.nextLine().split("\\s+");
        for (String s : input) {
            numbers.add(Integer.parseInt(s)); // Autoboxing
        }

        int sum = 0;
        for (Integer num : numbers) {
            sum += num; // Unboxing
        }
        System.out.println("Total Sum: " + sum);

        // ---------------- Part b: Serialization ----------------
        System.out.println("\nPart b: Serialization and Deserialization of a Student Object");
        Student student = new Student(101, "Alice", 9.5);

        // Serialize to file
        ObjectOutputStream oos = new ObjectOutputStream(new FileOutputStream("student.ser"));
        oos.writeObject(student);
        oos.close();

        // Deserialize from file
        ObjectInputStream ois = new ObjectInputStream(new FileInputStream("student.ser"));
        Student deserializedStudent = (Student) ois.readObject();
        ois.close();

        System.out.println("Deserialized Student: " + deserializedStudent);

        // ---------------- Part c: Employee Management ----------------
        System.out.println("\nPart c: Menu-Based Employee Management System");
        ArrayList<Employee> employees = new ArrayList<>();
        String empFile = "employees.dat";

        // Load existing employees if file exists
        File file = new File(empFile);
        if (file.exists()) {
            try (ObjectInputStream empOIS = new ObjectInputStream(new FileInputStream(file))) {
                employees = (ArrayList<Employee>) empOIS.readObject();
            } catch (Exception e) {
                employees = new ArrayList<>();
            }
        }

        int choice;
        do {
            System.out.println("\nMenu: 1-Add Employee  2-Display All Employees  0-Exit");
            System.out.print("Enter choice: ");
            choice = sc.nextInt();
            sc.nextLine(); // consume newline

            switch (choice) {
                case 1:
                    System.out.print("Enter ID: ");
                    int id = sc.nextInt();
                    sc.nextLine();
                    System.out.print("Enter Name: ");
                    String name = sc.nextLine();
                    System.out.print("Enter Designation: ");
                    String desig = sc.nextLine();
                    System.out.print("Enter Salary: ");
                    double salary = sc.nextDouble();
                    sc.nextLine();
                    Employee emp = new Employee(id, name, desig, salary);
                    employees.add(emp);
                    // Save to file
                    try (ObjectOutputStream empOOS = new ObjectOutputStream(new FileOutputStream(empFile))) {
                        empOOS.writeObject(employees);
                    }
                    System.out.println("Employee added successfully.");
                    break;
                case 2:
                    if (employees.isEmpty()) {
                        System.out.println("No employees.");
                    } else {
                        for (Employee e : employees) {
                            System.out.println(e);
                        }
                    }
                    break;
                case 0:
                    System.out.println("Exiting...");
                    break;
                default:
                    System.out.println("Invalid choice! Try again.");
            }
        } while (choice != 0);

        sc.close();
    }
}
